# Application Configuration
APP_NAME=JobPilot
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-secret-key-32bytes-min
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtYmFzZTY0LWtleS0wMTIzNDU2Nzg5=

# Database Configuration (PostgreSQL default, falls back to SQLite for local tests if postgres is offline)
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_secure_pwd@localhost:5432/jobpilot_db
DATABASE_URL_SYNC=postgresql+psycopg2://jobpilot:jobpilot_secure_pwd@localhost:5432/jobpilot_db
SQLITE_FALLBACK=True

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Services (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# JWT Auth
JWT_SECRET_KEY=jobpilot-jwt-super-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
