# Application Configuration
APP_NAME=JobPilot
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-secret-key-32bytes-min
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtYmFzZTY0LWtleS0wMTIzNDU2Nzg5=

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
SQLITE_FALLBACK=True

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Services (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# JWT & Cookie Auth
JWT_SECRET_KEY=jobpilot-jwt-super-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=access_token
COOKIE_SAMESITE=lax
SEED_DEMO_USER=false

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
